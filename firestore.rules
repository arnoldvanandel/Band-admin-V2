rules_version = '2';

// ============================================================================
//  Firestore security rules voor Band Admin
//  Alleen ingelogde bandleden mogen liedjes lezen en bewerken.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Liedjes: lezen en schrijven alleen voor ingelogde gebruikers.
    match /songs/{songId} {
      allow read, write: if request.auth != null;
    }

    // Gebruikersprofiel: alleen de eigenaar mag zijn eigen profiel beheren.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tekenlagen: iedere ingelogde gebruiker mag lezen; schrijven mag alleen de
    // eigenaar van de tekening (userId in het document moet de eigen uid zijn).
    match /drawings/{drawingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Setlists: gedeeld tussen alle ingelogde bandleden (geen userId-filtering).
    match /setlists/{setlistId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Akkoorden / Gitaargrepen: gedeeld, alleen ingelogde bandleden
    match /chords/{chordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Piano-akkoorden: gedeeld, alleen ingelogde bandleden
    match /pianoChords/{chordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Aanwezigheid: iedereen mag lezen; schrijven alleen je eigen document.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Oefenkeuze: gedeeld, alleen ingelogde bandleden mogen lezen/schrijven.
    match /practice/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Takenlijst: gedeeld, alleen ingelogde bandleden mogen lezen/schrijven.
    match /todos/{todoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Sessies (realtime setlist afspelen): gedeeld, alleen ingelogde bandleden.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Standaard: alles overige weigeren.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
