{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": [
    {
      "target": "test",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "README.md",
        ".git",
        ".git/**",
        ".firebase",
        ".firebase/**",
        "functions/**",
        "**/.*",
        "**/node_modules/**",
        "Kolonel & The Parkers - Songbeheer*.html",
        "Kolonel & The Parkers - Songbeheer*_files/**"
      ]
    },
    {
      "target": "live",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "README.md",
        ".git",
        ".git/**",
        ".firebase",
        ".firebase/**",
        "functions/**",
        "**/.*",
        "**/node_modules/**",
        "Kolonel & The Parkers - Songbeheer*.html",
        "Kolonel & The Parkers - Songbeheer*_files/**"
      ]
    }
  ]
}
